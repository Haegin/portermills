# Production settings, read by config/runtime.exs. Dev and test need none of these.
DATABASE_URL=ecto://USER:PASSWORD@localhost/portermills_prod
SECRET_KEY_BASE=          # mix phx.gen.secret
GUARDIAN_SECRET=          # mix phx.gen.secret
PHX_HOST=portermills.example
PORT=4000
PHX_SERVER=true

# Outgoing mail (magic links) over SMTP
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=            # an app password, not the account password
MAIL_FROM=
