DATABASE_URL=ecto://postgres:postgres@localhost/portermills_prod
SECRET_KEY_BASE=
GUARDIAN_SECRET=
PHX_HOST=portermills.app
PORT=4000

# Email invites (optional). Fastmail API token with Mail read/write access for the
# account that receives INVITES_EMAIL_ADDRESS. Leave unset to disable the poller.
FASTMAIL_API_TOKEN=
INVITES_EMAIL_ADDRESS=app@portermills.net
INVITES_POLL_SECONDS=60
# IANA zone used for invite times that carry no timezone (rare). Defaults to Etc/UTC.
DEFAULT_TIME_ZONE=
