DATABASE_URL=ecto://postgres:postgres@localhost/portermills_prod
SECRET_KEY_BASE=
GUARDIAN_SECRET=
PHX_HOST=portermills.app
PORT=4000

# Email invites (optional). Basic-auth credentials Postmark uses for the inbound
# webhook: https://USER:PASS@<host>/api/inbound/postmark. Leave unset to disable it.
POSTMARK_INBOUND_USERNAME=
POSTMARK_INBOUND_PASSWORD=
# IANA zone used for invite times that carry no timezone (rare). Defaults to Etc/UTC.
DEFAULT_TIME_ZONE=
