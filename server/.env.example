# Production settings, read by config/runtime.exs. Dev and test need none of these.
# Comments sit on their own lines because some env-file readers (systemd,
# docker --env-file) don't strip trailing comments.

DATABASE_URL=ecto://USER:PASSWORD@localhost/portermills_prod

# Generate each with: mix phx.gen.secret
SECRET_KEY_BASE=
GUARDIAN_SECRET=

# Public hostname (served through the Cloudflare tunnel) and local port.
PHX_HOST=api.portermills.net
PORT=2310
PHX_SERVER=true

# Outgoing mail (magic links) over Fastmail SMTP.
# SMTP_USERNAME is your Fastmail login; SMTP_PASSWORD is a Fastmail app
# password with SMTP access, not the account password.
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=app@portermills.net
